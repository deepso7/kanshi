{
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.117",
    "@effect/sql-sqlite-do": "4.0.0-rc.117",
    "alchemy": "2.0.0-beta.79",
    "effect": "4.0.0-rc.117"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260928.1",
    "@effect/language-service": "0.87.3",
    "@effect/platform-bun": "4.0.0-rc.117",
    "@effect/vitest": "4.0.0-rc.117",
    "@oxlint/plugins": "1.86.0",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.3",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typescript": "7.0.2",
    "ultracite": "7.12.1",
    "vitest": "5.0.2"
  },
  "name": "kanshi",
  "scripts": {
    "dev": "CLOUDFLARE_ACCOUNT_ID=00000000000000000000000000000000 CLOUDFLARE_API_TOKEN=local-dev-placeholder alchemy dev --stage dev",
    "seed": "bun scripts/kanshi.ts sync --config kanshi.dev.config.ts --url http://localhost:1337 --adopt --wait 30",
    "kanshi": "bun scripts/kanshi.ts",
    "deploy": "alchemy deploy --stage prod",
    "destroy": "alchemy destroy --stage prod",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:integ": "CLOUDFLARE_ACCOUNT_ID=00000000000000000000000000000000 CLOUDFLARE_API_TOKEN=local-dev-placeholder bun test test/integ",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "Self-hosted uptime monitor on one Cloudflare Worker: Durable Objects, alerts, dashboard and status page.",
  "license": "ISC"
}
