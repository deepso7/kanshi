{
  // The SPA. It also type-checks the modules it imports from ../src (the
  // HttpApi spec and the domain schemas) against the DOM, without Node,
  // Bun or Worker types: they must stay browser-safe.
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    "types": ["vite/client"],

    "plugins": [
      {
        "name": "@effect/language-service"
      }
    ]
  },
  "include": ["src", "../reset.d.ts"]
}
